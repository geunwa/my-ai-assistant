# 쉼표로 구분한 CORS 허용 주소 (프론트엔드 주소)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Firebase 서비스 계정 키 (둘 중 하나만 설정한다)
# 내 PC: 키 파일 경로
FIREBASE_SERVICE_ACCOUNT_PATH=C:/Users/내이름/firebase-keys/firebase-key.json
# 배포 환경(Render): 키 파일의 JSON 내용 전체
# FIREBASE_SERVICE_ACCOUNT_JSON=
# OpenAI (채팅). 키는 절대 커밋하지 않는다
OPENAI_API_KEY=
# 사용할 모델 (기본값 gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# 답변 최대 토큰 (기본값 400). 추론형 모델은 추론에도 토큰을 쓰므로 넉넉히 둔다
OPENAI_MAX_TOKENS=400
# 다른 주소의 OpenAI 호환 서버를 쓸 때만 설정 (SDK가 자동으로 읽는다)
# OPENAI_BASE_URL=
